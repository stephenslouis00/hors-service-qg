rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function isMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/allowlist/$(callerEmail()));
    }

    function isAdmin() {
      return isMember() &&
        get(/databases/$(database)/documents/allowlist/$(callerEmail())).data.role == 'admin';
    }

    // The owner account can't be demoted or removed by anyone, including other
    // admins — guarantees there's always at least one way back into the app.
    function isProtectedOwner(email) {
      return email == 'stephenslouis00@gmail.com';
    }

    match /allowlist/{email} {
      allow read: if isMember();
      allow create, update: if isAdmin() &&
        !(isProtectedOwner(email) && request.resource.data.role != 'admin');
      allow delete: if isAdmin() && !isProtectedOwner(email);
    }

    match /adminDocuments/{docId} {
      allow read, write: if isMember();
    }

    match /songs/{songId} {
      allow read, write: if isMember();

      match /feedback/{feedbackId} {
        allow read, write: if isMember();
      }
    }

    match /promoContent/{itemId} {
      allow read, write: if isMember();
    }

    match /promoCalendarEvents/{eventId} {
      allow read, write: if isMember();
    }

    match /releases/{releaseId} {
      allow read, write: if isMember();

      match /checklist/{itemId} {
        allow read, write: if isMember();
      }
    }

    match /promoContacts/{contactId} {
      allow read, write: if isMember();
    }

    match /bookingShows/{showId} {
      allow read, write: if isMember();
    }

    match /venues/{venueId} {
      allow read, write: if isMember();
    }

    match /settings/{docId} {
      allow read, write: if isMember();
    }
  }
}
